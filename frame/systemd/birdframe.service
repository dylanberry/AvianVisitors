[Unit]
Description=Bird Up! e-ink frame update
Documentation=https://github.com/dylanberry/BirdUp
Wants=network-online.target
After=network-online.target

[Service]
# install.sh rewrites User= and the paths to match your install.
Type=oneshot
User=monalisa
WorkingDirectory=/home/monalisa/BirdUp/frame
ExecStart=/home/monalisa/BirdUp/frame/.venv/bin/python /home/monalisa/BirdUp/frame/display.py --config /home/monalisa/.birdframe/config.toml
Environment=PYTHONUNBUFFERED=1
Nice=10
TimeoutStartSec=300
