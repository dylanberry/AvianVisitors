[Unit]
Description=Bird Up! RTSP relay (mediamtx) - mic stream for the cluster BirdNET-Go
After=network-online.target birdup-fanout.service
Wants=network-online.target birdup-fanout.service

[Service]
Type=simple
User=dylanberry
ExecStart=/usr/local/bin/mediamtx /etc/mediamtx/mediamtx.yml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target